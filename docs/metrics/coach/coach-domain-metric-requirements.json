      "minimum_sample": {
        "single_match_rounds": 8,
        "rolling_matches": 3,
        "rolling_rounds": 8
      },
      "confidence_policy": "validated semantic version 3.0.0; medium/high metric confidence; mission requires hard-recommendation eligibility",
      "missing_data_behavior": "No claim and no mission candidate.",
