{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-domain-hypothesis-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_key", "analysis_status", "headline", "hypothesis", "reasoning_summary", "primary_pattern", "evidence_refs", "counterevidence_refs", "metric_refs", "match_refs", "confidence", "confidence_rationale", "caveats", "recommended_focus", "mission_proposal"],
  "properties": {
    "schema_version": {"type": "string", "const": "ai-domain-hypothesis-v1"},
    "domain_key": {"type": "string", "enum": ["impact_leak", "bad_fight_selection"]},
    "analysis_status": {"type": "string", "enum": ["supported_hypothesis", "no_material_problem", "insufficient_evidence"]},
    "headline": {"type": "string", "maxLength": 120},
    "hypothesis": {"type": "string", "maxLength": 800},
    "reasoning_summary": {"type": "string", "maxLength": 1200},
    "primary_pattern": {"type": "string", "maxLength": 500},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "counterevidence_refs": {"type": "array", "items": {"type": "string"}},
    "metric_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["metric_key", "value", "evidence_ref"], "properties": {"metric_key": {"type": "string"}, "value": {"type": "number"}, "evidence_ref": {"type": "string"}}}},
    "match_refs": {"type": "array", "items": {"type": "integer"}},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "confidence_rationale": {"type": "string", "maxLength": 500},
    "caveats": {"type": "array", "items": {"type": "string", "maxLength": 300}},
    "recommended_focus": {"type": "string", "maxLength": 500},
    "mission_proposal": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["title", "goal", "behavioral_focus", "primary_metric", "secondary_metrics", "guardrail_metrics", "baseline_value", "target_direction", "target_value", "target_delta", "minimum_future_matches", "maximum_future_matches", "success_definition", "failure_or_regression_definition", "per_match_feedback_template"],
          "properties": {
            "title": {"type": "string", "maxLength": 120}, "goal": {"type": "string", "maxLength": 300},
            "behavioral_focus": {"type": "string", "maxLength": 400}, "primary_metric": {"type": "string"},
            "secondary_metrics": {"type": "array", "items": {"type": "string"}},
            "guardrail_metrics": {"type": "array", "items": {"type": "string"}},
            "baseline_value": {"type": "number"},
            "target_direction": {"type": "string", "enum": ["higher_is_better", "lower_is_better", "stay_above_guardrail"]},
            "target_value": {"type": ["number", "null"]}, "target_delta": {"type": ["number", "null"]},
            "minimum_future_matches": {"type": "integer", "minimum": 3, "maximum": 5},
            "maximum_future_matches": {"type": "integer", "minimum": 3, "maximum": 5},
            "success_definition": {"type": "string", "maxLength": 400},
            "failure_or_regression_definition": {"type": "string", "maxLength": 400},
            "per_match_feedback_template": {"type": "string", "maxLength": 400}
          }
        }
      ]
    }
  }
}
