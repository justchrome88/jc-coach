APP_NAME=CS2 Personal Coach
APP_ENV=local
DATABASE_URL=sqlite:///data/cs2_coach.db
UPLOAD_DIR=data/uploads
DEMO_INBOX_DIR=data/incoming_demos
REPORTS_DIR=data/reports
AI_HANDOFF_DIR=data/ai_handoffs
AI_PROVIDER=codex_cli_handoff
AI_CODEX_COMMAND=codex exec
# Future local LLM provider.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_TIMEOUT_SECONDS=90
# Steam OpenID scaffold. Use your reachable app URL.
PUBLIC_BASE_URL=http://jcnodex.ru
STEAM_REALM=http://jcnodex.ru
STEAM_RETURN_PATH=/auth/steam/callback
# Set a long random value before APP_ENV=production/staging.
SESSION_SECRET_KEY=change-me-before-public-release
AUTH_COOKIE_SECURE=false
# Optional Bearer token for non-browser API clients. Browser sessions also work.
# API_TOKEN=
# Required for Steam match-history sync:
# STEAM_WEB_API_KEY=
# STEAM_SYNC_MAX_CODES=20
# Steam retained-raw runtime storage guard defaults:
# STEAM_IMPORT_MAX_DEMOS_PER_RUN=1
# STEAM_IMPORT_MAX_BYTES_PER_JOB=2147483648
# STEAM_IMPORT_MAX_SINGLE_DEMO_BYTES=629145600
# STEAM_IMPORT_MIN_FREE_BYTES=8589934592
# STEAM_IMPORT_PRESERVE_FREE_BYTES=5368709120
# STEAM_IMPORT_UNKNOWN_DEMO_RESERVE_BYTES=1610612736
# Optional: player name or SteamID to pick from uploaded .dem files.
# DEMO_PLAYER_IDENTIFIER=
# OPENAI_API_KEY=
