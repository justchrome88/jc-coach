{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric-registry.schema.json",
  "title": "JC Coach metric registry",
  "type": "object",
  "required": ["registry_version", "metrics"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_key", "display_name", "domain", "scope", "unit", "value_type", "source_kind",
          "source_tables_or_events", "identity_keys", "numerator_definition", "denominator_definition",
          "include_rules", "exclude_rules", "rounding_storage", "rounding_display", "semantic_version",
          "implementation_entrypoints", "persistence_targets", "ui_consumers", "coach_consumers",
          "validation_rules", "ground_truth_status", "status", "last_verified_evidence", "known_discrepancies"
          , "critical", "classification", "round_phase_boundary", "validation_status",
          "consumer_policy", "backfill_requirement"
        ],
        "properties": {
          "metric_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "display_name": {"type": "string", "minLength": 1},
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Legacy registry field name for a metric group/source classification; never a coach domain."
          },
          "scope": {"enum": ["match", "player_match", "player_round", "player_weapon_match", "aggregate_window"]},
          "unit": {"type": "string"},
          "value_type": {"enum": ["integer", "number", "percentage", "ratio", "string", "nullable_number"]},
          "source_kind": {"type": "string"},
          "source_tables_or_events": {"type": "array", "items": {"type": "string"}},
          "identity_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "numerator_definition": {"type": ["string", "null"]},
          "denominator_definition": {"type": ["string", "null"]},
          "include_rules": {"type": "array", "items": {"type": "string"}},
          "exclude_rules": {"type": "array", "items": {"type": "string"}},
          "rounding_storage": {"type": "string"},
          "rounding_display": {"type": "string"},
          "semantic_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "implementation_entrypoints": {"type": "array", "items": {"type": "string"}},
          "persistence_targets": {"type": "array", "items": {"type": "string"}},
          "ui_consumers": {"type": "array", "items": {"type": "string"}},
          "coach_consumers": {"type": "array", "items": {"type": "string"}},
          "validation_rules": {"type": "array", "items": {"type": "string"}},
          "ground_truth_status": {"enum": ["verified", "partially_verified", "disputed", "unknown", "not_applicable"]},
          "status": {"enum": ["active", "experimental", "deprecated", "blocked"]},
          "last_verified_evidence": {"type": "array", "items": {"type": "string"}},
          "known_discrepancies": {"type": "array", "items": {"type": "string"}}
          ,"critical": {"type": "boolean"},
          "classification": {"enum": ["validated_candidate", "confirmed_defect", "semantic_difference", "disputed_missing_evidence", "experimental", "deprecated"]},
          "round_phase_boundary": {"type": "string", "minLength": 1},
          "validation_status": {"enum": ["validated", "quarantined", "rejected", "unavailable"]},
          "consumer_policy": {"enum": ["trusted", "label_semantic_difference", "unavailable", "forbidden"]},
          "backfill_requirement": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
